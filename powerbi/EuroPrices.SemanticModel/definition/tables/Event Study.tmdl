table 'Event Study'
	lineageTag: 29a57642-7d23-56d5-8ca1-f8034e8929c6

	/// Adopter minus control, in index points (both = 100 the month before adoption). Blank outside the window picked in the Window table
	measure Excess = VAR w = SELECTEDVALUE('Window'[months], 24) VAR t = MAX('Event Study'[event_month]) RETURN IF(ABS(t) <= w, AVERAGE('Event Study'[excess_points]))
		formatString: 0.0
		lineageTag: 28443e97-cb50-53dc-b5c6-ed6e946a7b7e

	/// Excess minus the pre-adoption trend, fitted over the last N months before adoption (N = the window picked in the Window table)
	measure 'Excess (trend-adjusted)' = VAR w = SELECTEDVALUE('Window'[months], 24) VAR t = MAX('Event Study'[event_month]) RETURN IF(ABS(t) <= w, AVERAGEX('Event Study', VAR s = SWITCH(w, 12, 'Event Study'[pre_slope_12], 36, 'Event Study'[pre_slope_36], 48, 'Event Study'[pre_slope_48], 'Event Study'[pre_slope_24]) RETURN IF(NOT ISBLANK(s) && NOT ISBLANK('Event Study'[excess_points]), 'Event Study'[excess_points] - s * ('Event Study'[event_month] + 1))))
		formatString: 0.0
		lineageTag: 6758caed-7ed2-5001-b448-736c71ec1f1a

	/// Adopter prices, 100 = month before adoption
	measure 'Adopter index' = VAR w = SELECTEDVALUE('Window'[months], 24) VAR t = MAX('Event Study'[event_month]) RETURN IF(ABS(t) <= w, AVERAGE('Event Study'[index_rel]))
		formatString: 0.0
		lineageTag: 637fc1b9-38fd-5e38-aaac-3cb587a00832

	/// Control prices over the same calendar months, 100 = adopter's base month
	measure 'Control index' = VAR w = SELECTEDVALUE('Window'[months], 24) VAR t = MAX('Event Study'[event_month]) RETURN IF(ABS(t) <= w, AVERAGE('Event Study'[control_rel]))
		formatString: 0.0
		lineageTag: 08b1917b-8be6-5b1b-9f56-96b9e00b950f

	/// Average excess over the last 12 months; removes the summer tourist season. At month 11 it is the average over the first year of the euro
	measure 'Excess (12-month avg)' = VAR w = SELECTEDVALUE('Window'[months], 24) VAR t = MAX('Event Study'[event_month]) RETURN IF(ABS(t) <= w && t >= -37, CALCULATE([Excess], 'Event Study'[event_month] > t - 12, 'Event Study'[event_month] <= t))
		formatString: 0.0
		lineageTag: 7612d5b2-56e1-5f9e-80c2-034097785146

	/// Trend-adjusted excess averaged over the last 12 months
	measure 'Excess (trend-adjusted, 12-month avg)' = VAR w = SELECTEDVALUE('Window'[months], 24) VAR t = MAX('Event Study'[event_month]) RETURN IF(ABS(t) <= w && t >= -37, CALCULATE([Excess (trend-adjusted)], 'Event Study'[event_month] > t - 12, 'Event Study'[event_month] <= t))
		formatString: 0.0
		lineageTag: 3dfd2683-3013-5963-8ac0-ec765e30b167

	/// Excess at event_month 11 (12 months after the base month)
	measure 'Excess after 1 year' = CALCULATE([Excess], 'Event Study'[event_month] = 11)
		formatString: 0.0
		lineageTag: 3474cd9e-ca5a-56ec-a269-afe806652ce8

	/// Trend-adjusted excess at event_month 11
	measure 'Excess after 1 year (trend-adjusted)' = CALCULATE([Excess (trend-adjusted)], 'Event Study'[event_month] = 11)
		formatString: 0.0
		lineageTag: 3765fe52-a30c-557b-a0d8-5273882c2178

